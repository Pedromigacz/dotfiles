{
  "$schema": "https://opencode.ai/config.json",
  "mcp": {
    "aws-mcp": {
      "type": "local",
      "command": [
        "uvx",
        "mcp-proxy-for-aws@latest",
        "https://aws-mcp.us-east-1.api.aws/mcp",
        "--metadata",
        "INSTALL_SOURCE=aws-cli"
      ]
    }
  },
  "plugin": [
    ["./auto-mode/index.ts", {
      "model": "openai/gpt-6-astra",
      "timeoutMs": 20000,
      "minConfidence": 0.9,
      "maxConcurrentReviews": 2,
      "notify": true
    }]
  ],
  "permission": {
    "external_directory": {
      "~/Work": "allow",
      "~/Work/**": "allow",
      "~/.config/opencode": "allow",
      "~/.config/opencode/**": "allow",
      "~/.claude/skills": "allow",
      "~/.claude/skills/**": "allow",
      "~/.agents/skills": "allow",
      "~/.agents/skills/**": "allow"
    }
  }
}
