{
  "$schema": "https://opencode.ai/config.json",
  "mcp": {
    "servers": {
      "aws-mcp": {
        "type": "local",
        "command": [
          "uvx",
          "mcp-proxy-for-aws@latest",
          "https://aws-mcp.us-east-1.api.aws/mcp",
          "--metadata",
          "INSTALL_SOURCE=aws-cli"
        ]
      },
      "kaneo": {
        "type": "remote",
        "url": "https://projects.migaczbrothers.com/api/mcp"
      }
    }
  },
  "plugins": [
    { "package": "./auto-mode", "options": {
      "model": "openai/gpt-6-astra",
      "timeoutMs": 20000,
      "minConfidence": 0.9,
      "maxConcurrentReviews": 2,
      "notify": true
    }}
  ],
  "agents": {
    "automode": {
      "description": "Build with automatic permission review for routine operations",
      "mode": "primary",
      "hidden": false,
      "permissions": [
        { "action": "question", "resource": "*", "effect": "allow" },
        { "action": "shell", "resource": "*", "effect": "ask" },
        // Verification scripts, including variants such as test:unit and lint:fix.
        { "action": "shell", "resource": "bun run test*", "effect": "allow" },
        { "action": "shell", "resource": "bun run lint*", "effect": "allow" },
        { "action": "shell", "resource": "bun run check*", "effect": "allow" },
        { "action": "shell", "resource": "bun run typecheck*", "effect": "allow" },
        { "action": "shell", "resource": "bun run type-check*", "effect": "allow" },
        { "action": "shell", "resource": "bun run coverage*", "effect": "allow" },
        { "action": "shell", "resource": "bun run build*", "effect": "allow" },
        { "action": "shell", "resource": "bun test *", "effect": "allow" },
        { "action": "shell", "resource": "npm run test*", "effect": "allow" },
        { "action": "shell", "resource": "npm run lint*", "effect": "allow" },
        { "action": "shell", "resource": "npm run check*", "effect": "allow" },
        { "action": "shell", "resource": "npm run typecheck*", "effect": "allow" },
        { "action": "shell", "resource": "npm run type-check*", "effect": "allow" },
        { "action": "shell", "resource": "npm run coverage*", "effect": "allow" },
        { "action": "shell", "resource": "npm run build*", "effect": "allow" },
        { "action": "shell", "resource": "npm test *", "effect": "allow" },
        { "action": "shell", "resource": "pnpm run test*", "effect": "allow" },
        { "action": "shell", "resource": "pnpm run lint*", "effect": "allow" },
        { "action": "shell", "resource": "pnpm run check*", "effect": "allow" },
        { "action": "shell", "resource": "pnpm run typecheck*", "effect": "allow" },
        { "action": "shell", "resource": "pnpm run type-check*", "effect": "allow" },
        { "action": "shell", "resource": "pnpm run coverage*", "effect": "allow" },
        { "action": "shell", "resource": "pnpm run build*", "effect": "allow" },
        { "action": "shell", "resource": "pnpm test*", "effect": "allow" },
        { "action": "shell", "resource": "pnpm lint*", "effect": "allow" },
        { "action": "shell", "resource": "pnpm check*", "effect": "allow" },
        { "action": "shell", "resource": "pnpm typecheck*", "effect": "allow" },
        { "action": "shell", "resource": "pnpm type-check*", "effect": "allow" },
        { "action": "shell", "resource": "pnpm coverage*", "effect": "allow" },
        { "action": "shell", "resource": "pnpm build*", "effect": "allow" },
        { "action": "shell", "resource": "yarn test*", "effect": "allow" },
        { "action": "shell", "resource": "yarn lint*", "effect": "allow" },
        { "action": "shell", "resource": "yarn check*", "effect": "allow" },
        { "action": "shell", "resource": "yarn typecheck*", "effect": "allow" },
        { "action": "shell", "resource": "yarn type-check*", "effect": "allow" },
        { "action": "shell", "resource": "yarn coverage*", "effect": "allow" },
        { "action": "shell", "resource": "yarn build*", "effect": "allow" },
        // Direct tools and package-runner equivalents.
        { "action": "shell", "resource": "prettier --check *", "effect": "allow" },
        { "action": "shell", "resource": "bunx prettier --check *", "effect": "allow" },
        { "action": "shell", "resource": "npx prettier --check *", "effect": "allow" },
        { "action": "shell", "resource": "pnpm exec prettier --check *", "effect": "allow" },
        { "action": "shell", "resource": "shellcheck *", "effect": "allow" },
        { "action": "shell", "resource": "biome *", "effect": "allow" },
        { "action": "shell", "resource": "bunx biome *", "effect": "allow" },
        { "action": "shell", "resource": "bunx run biome *", "effect": "allow" },
        { "action": "shell", "resource": "bunx @biomejs/biome *", "effect": "allow" },
        { "action": "shell", "resource": "npx biome *", "effect": "allow" },
        { "action": "shell", "resource": "npx @biomejs/biome *", "effect": "allow" },
        { "action": "shell", "resource": "pnpm exec biome *", "effect": "allow" },
        { "action": "shell", "resource": "eslint *", "effect": "allow" },
        { "action": "shell", "resource": "bunx eslint *", "effect": "allow" },
        { "action": "shell", "resource": "npx eslint *", "effect": "allow" },
        { "action": "shell", "resource": "pnpm exec eslint *", "effect": "allow" },
        { "action": "shell", "resource": "tsc *", "effect": "allow" },
        { "action": "shell", "resource": "bunx tsc *", "effect": "allow" },
        { "action": "shell", "resource": "npx tsc *", "effect": "allow" },
        { "action": "shell", "resource": "pnpm exec tsc *", "effect": "allow" },
        { "action": "shell", "resource": "vitest *", "effect": "allow" },
        { "action": "shell", "resource": "bunx vitest *", "effect": "allow" },
        { "action": "shell", "resource": "npx vitest *", "effect": "allow" },
        { "action": "shell", "resource": "pnpm exec vitest *", "effect": "allow" },
        { "action": "shell", "resource": "jest *", "effect": "allow" },
        { "action": "shell", "resource": "bunx jest *", "effect": "allow" },
        { "action": "shell", "resource": "npx jest *", "effect": "allow" },
        { "action": "shell", "resource": "pnpm exec jest *", "effect": "allow" },
        { "action": "shell", "resource": "bunx playwright test *", "effect": "allow" },
        { "action": "shell", "resource": "npx playwright test *", "effect": "allow" },
        { "action": "shell", "resource": "pnpm exec playwright test *", "effect": "allow" },
        { "action": "shell", "resource": "pytest *", "effect": "allow" },
        { "action": "shell", "resource": "python -m pytest *", "effect": "allow" },
        { "action": "shell", "resource": "python3 -m pytest *", "effect": "allow" },
        { "action": "shell", "resource": "python -m unittest *", "effect": "allow" },
        { "action": "shell", "resource": "python3 -m unittest *", "effect": "allow" },
        { "action": "shell", "resource": "uv run pytest *", "effect": "allow" },
        { "action": "shell", "resource": "ruff check *", "effect": "allow" },
        { "action": "shell", "resource": "uv run ruff check *", "effect": "allow" },
        { "action": "shell", "resource": "mypy *", "effect": "allow" },
        { "action": "shell", "resource": "uv run mypy *", "effect": "allow" },
        { "action": "shell", "resource": "cargo test *", "effect": "allow" },
        { "action": "shell", "resource": "cargo check *", "effect": "allow" },
        { "action": "shell", "resource": "cargo clippy *", "effect": "allow" },
        { "action": "shell", "resource": "cargo build *", "effect": "allow" },
        { "action": "shell", "resource": "go test *", "effect": "allow" },
        { "action": "shell", "resource": "go vet *", "effect": "allow" },
        { "action": "shell", "resource": "go build *", "effect": "allow" },
        { "action": "shell", "resource": "make test *", "effect": "allow" },
        { "action": "shell", "resource": "make check *", "effect": "allow" },
        { "action": "shell", "resource": "make lint *", "effect": "allow" },
        { "action": "webfetch", "resource": "*", "effect": "ask" },
        { "action": "aws-mcp_*", "resource": "*", "effect": "ask" }
      ]
    }
  },
  "permission": {
    "external_directory": {
      "~/Work": "allow",
      "~/Work/**": "allow",
      "~/.config/opencode": "allow",
      "~/.config/opencode/**": "allow",
      "~/.claude/skills": "allow",
      "~/.claude/skills/**": "allow",
      "~/.agents/skills": "allow",
      "~/.agents/skills/**": "allow"
    }
  }
}
