{
  "$schema": "https://opencode.ai/config.json",
  "plugin": [
    ["./auto-mode/index.ts", {
      "model": "openai/gpt-6-astra",
      "timeoutMs": 20000,
      "minConfidence": 0.9,
      "maxConcurrentReviews": 2,
      "notify": true
    }]
  ],
  "permission": {
    "external_directory": {
      "~/Work": "allow",
      "~/Work/**": "allow",
      "~/.config/opencode": "allow",
      "~/.config/opencode/**": "allow",
      "~/.claude/skills": "allow",
      "~/.claude/skills/**": "allow",
      "~/.agents/skills": "allow",
      "~/.agents/skills/**": "allow"
    }
  }
}
