{
  "$schema": "https://opencode.ai/config.json",
  "mcp": {
    "servers": {
      "aws-mcp": {
        "type": "local",
        "command": [
          "uvx",
          "mcp-proxy-for-aws@latest",
          "https://aws-mcp.us-east-1.api.aws/mcp",
          "--metadata",
          "INSTALL_SOURCE=aws-cli"
        ]
      },
      "kaneo": {
        "type": "remote",
        "url": "https://projects.migaczbrothers.com/api/mcp"
      }
    }
  },
  "plugins": [
    { "package": "./auto-mode", "options": {
      "model": "openai/gpt-6-astra",
      "timeoutMs": 20000,
      "minConfidence": 0.9,
      "maxConcurrentReviews": 2,
      "notify": true
    }}
  ],
  "agents": {
    "automode": {
      "description": "Build with automatic permission review for routine operations",
      "mode": "primary",
      "hidden": false,
      "permissions": [
        { "action": "question", "resource": "*", "effect": "allow" },
        { "action": "shell", "resource": "*", "effect": "ask" },
        // Routine inspection: approve directly, even when reviewer context is unavailable.
        { "action": "shell", "resource": "git diff *", "effect": "allow" },
        { "action": "shell", "resource": "git status *", "effect": "allow" },
        { "action": "shell", "resource": "git log *", "effect": "allow" },
        { "action": "shell", "resource": "git grep *", "effect": "allow" },
        { "action": "shell", "resource": "ls *", "effect": "allow" },
        { "action": "shell", "resource": "rg *", "effect": "allow" },
        { "action": "shell", "resource": "sort", "effect": "allow" },
        { "action": "shell", "resource": "uniq -c", "effect": "allow" },
        { "action": "shell", "resource": "chromium --version", "effect": "allow" },
        { "action": "shell", "resource": "node --version", "effect": "allow" },
        { "action": "shell", "resource": "opencode debug agent build", "effect": "allow" },
        { "action": "shell", "resource": "node -e \"for (const m of ['playwright','puppeteer','@playwright/test']) {try {console.log(m,require.resolve(m))}catch{console.log(m,'unavailable')}}\"", "effect": "allow" },
        { "action": "shell", "resource": "curl -sS --max-time 30 https://dwightcapital.com/cdn-cgi/trace", "effect": "allow" },
        { "action": "shell", "resource": "curl -sS -D - -o /dev/null https://dwightcapital.com/__consent/region", "effect": "allow" },
        // Audited build/test wrappers (environment assignments and selected Node versions).
        { "action": "shell", "resource": "DOTENV_CONFIG_PATH=.env NODE_OPTIONS=--require=dotenv/config GATSBY_CPU_COUNT=2 npm run build", "effect": "allow" },
        { "action": "shell", "resource": "mise exec node@20.20.2 -- env DOTENV_CONFIG_PATH=.env NODE_OPTIONS=--require=dotenv/config GATSBY_CPU_COUNT=2 npm run build", "effect": "allow" },
        { "action": "shell", "resource": "mise exec node@20.20.2 -- env DOTENV_CONFIG_PATH=.env NODE_OPTIONS=--require=dotenv/config GATSBY_CPU_COUNT=4 npm run build", "effect": "allow" },
        { "action": "shell", "resource": "mise exec node@20.20.2 -- env DOTENV_CONFIG_PATH=.env NODE_OPTIONS=--require=dotenv/config GATSBY_CPU_COUNT=4 GATSBY_CLOUD_IMAGE_CDN=1 npm run build", "effect": "allow" },
        { "action": "shell", "resource": "mise exec node@20 -- env DOTENV_CONFIG_PATH=.env NODE_OPTIONS=--require=dotenv/config GATSBY_CPU_COUNT=4 GATSBY_CLOUD_IMAGE_CDN=1 npm run build", "effect": "allow" },
        { "action": "shell", "resource": "PATH=/home/pedro/.local/share/mise/installs/node/20.20.2/bin:$PATH DOTENV_CONFIG_PATH=.env NODE_OPTIONS=--require=dotenv/config GATSBY_CPU_COUNT=4 GATSBY_CLOUD_IMAGE_CDN=1 npm run build", "effect": "allow" },
        { "action": "shell", "resource": "DOTENV_CONFIG_PATH=.env NODE_OPTIONS=--require=dotenv/config GATSBY_CPU_COUNT=4 GATSBY_CLOUD_IMAGE_CDN=1 npx --yes --package=node@20 -c 'npm run build'", "effect": "allow" },
        { "action": "shell", "resource": "npx --yes --package=node@20 -c 'node --version && DOTENV_CONFIG_PATH=.env NODE_OPTIONS=--require=dotenv/config GATSBY_CPU_COUNT=4 GATSBY_CLOUD_IMAGE_CDN=1 npm run build'", "effect": "allow" },
        { "action": "shell", "resource": "npx --yes --package=node@20 -c 'DOTENV_CONFIG_PATH=.env NODE_OPTIONS=--require=dotenv/config GATSBY_CPU_COUNT=4 GATSBY_CLOUD_IMAGE_CDN=1 npm run build'", "effect": "allow" },
        { "action": "shell", "resource": "mise exec node@20.20.2 -- env DOTENV_CONFIG_PATH=.env NODE_OPTIONS=--require=dotenv/config CHROMIUM_PATH=/usr/bin/chromium npm run test:consent:browser *", "effect": "allow" },
        { "action": "shell", "resource": "mise exec node@20.20.2 -- env DOTENV_CONFIG_PATH=.env NODE_OPTIONS=--require=dotenv/config CHROMIUM_PATH=/usr/bin/chromium CONSENT_LIVE_GA=1 npm run test:consent:browser *", "effect": "allow" },
        { "action": "shell", "resource": "mise exec node@20 -- env DOTENV_CONFIG_PATH=.env NODE_OPTIONS=--require=dotenv/config CHROMIUM_PATH=/usr/bin/chromium npm run test:consent:browser *", "effect": "allow" },
        { "action": "shell", "resource": "mise exec node@20 -- env DOTENV_CONFIG_PATH=.env NODE_OPTIONS=--require=dotenv/config CONSENT_LIVE_GA=1 CHROMIUM_PATH=/usr/bin/chromium npm run test:consent:browser *", "effect": "allow" },
        { "action": "shell", "resource": "PATH=/home/pedro/.local/share/mise/installs/node/20.20.2/bin:$PATH DOTENV_CONFIG_PATH=.env NODE_OPTIONS=--require=dotenv/config CHROMIUM_PATH=/usr/bin/chromium npm run test:consent:browser *", "effect": "allow" },
        { "action": "shell", "resource": "PATH=/home/pedro/.local/share/mise/installs/node/20.20.2/bin:$PATH DEBUG=pw:webserver CHROMIUM_PATH=/usr/bin/chromium npm run test:consent:browser *", "effect": "allow" },
        { "action": "shell", "resource": "CHROMIUM_PATH=/usr/bin/chromium npm run test:consent:browser *", "effect": "allow" },
        { "action": "shell", "resource": "npx --yes --package=node@20 -c 'DOTENV_CONFIG_PATH=.env NODE_OPTIONS=--require=dotenv/config CHROMIUM_PATH=/usr/bin/chromium npm run test:consent:browser'", "effect": "allow" },
        { "action": "shell", "resource": "npx --yes --package=node@20 -c 'DOTENV_CONFIG_PATH=.env NODE_OPTIONS=--require=dotenv/config CHROMIUM_PATH=/usr/bin/chromium npm run test:consent:browser -- returning.spec.js'", "effect": "allow" },
        // Verification scripts, including variants such as test:unit and lint:fix.
        { "action": "shell", "resource": "bun run test*", "effect": "allow" },
        { "action": "shell", "resource": "bun run lint*", "effect": "allow" },
        { "action": "shell", "resource": "bun run check*", "effect": "allow" },
        { "action": "shell", "resource": "bun run typecheck*", "effect": "allow" },
        { "action": "shell", "resource": "bun run type-check*", "effect": "allow" },
        { "action": "shell", "resource": "bun run coverage*", "effect": "allow" },
        { "action": "shell", "resource": "bun run build*", "effect": "allow" },
        { "action": "shell", "resource": "bun test *", "effect": "allow" },
        { "action": "shell", "resource": "npm run test*", "effect": "allow" },
        { "action": "shell", "resource": "npm run lint*", "effect": "allow" },
        { "action": "shell", "resource": "npm run check*", "effect": "allow" },
        { "action": "shell", "resource": "npm run typecheck*", "effect": "allow" },
        { "action": "shell", "resource": "npm run type-check*", "effect": "allow" },
        { "action": "shell", "resource": "npm run coverage*", "effect": "allow" },
        { "action": "shell", "resource": "npm run build*", "effect": "allow" },
        { "action": "shell", "resource": "npm test *", "effect": "allow" },
        { "action": "shell", "resource": "pnpm run test*", "effect": "allow" },
        { "action": "shell", "resource": "pnpm run lint*", "effect": "allow" },
        { "action": "shell", "resource": "pnpm run check*", "effect": "allow" },
        { "action": "shell", "resource": "pnpm run typecheck*", "effect": "allow" },
        { "action": "shell", "resource": "pnpm run type-check*", "effect": "allow" },
        { "action": "shell", "resource": "pnpm run coverage*", "effect": "allow" },
        { "action": "shell", "resource": "pnpm run build*", "effect": "allow" },
        { "action": "shell", "resource": "pnpm test*", "effect": "allow" },
        { "action": "shell", "resource": "pnpm lint*", "effect": "allow" },
        { "action": "shell", "resource": "pnpm check*", "effect": "allow" },
        { "action": "shell", "resource": "pnpm typecheck*", "effect": "allow" },
        { "action": "shell", "resource": "pnpm type-check*", "effect": "allow" },
        { "action": "shell", "resource": "pnpm coverage*", "effect": "allow" },
        { "action": "shell", "resource": "pnpm build*", "effect": "allow" },
        { "action": "shell", "resource": "yarn test*", "effect": "allow" },
        { "action": "shell", "resource": "yarn lint*", "effect": "allow" },
        { "action": "shell", "resource": "yarn check*", "effect": "allow" },
        { "action": "shell", "resource": "yarn typecheck*", "effect": "allow" },
        { "action": "shell", "resource": "yarn type-check*", "effect": "allow" },
        { "action": "shell", "resource": "yarn coverage*", "effect": "allow" },
        { "action": "shell", "resource": "yarn build*", "effect": "allow" },
        // Direct tools and package-runner equivalents.
        { "action": "shell", "resource": "prettier --write *", "effect": "allow" },
        { "action": "shell", "resource": "bunx prettier --write *", "effect": "allow" },
        { "action": "shell", "resource": "npx prettier --write *", "effect": "allow" },
        { "action": "shell", "resource": "pnpm exec prettier --write *", "effect": "allow" },
        { "action": "shell", "resource": "node node_modules/prettier/bin-prettier.js --write *", "effect": "allow" },
        { "action": "shell", "resource": "prettier --check *", "effect": "allow" },
        { "action": "shell", "resource": "bunx prettier --check *", "effect": "allow" },
        { "action": "shell", "resource": "npx prettier --check *", "effect": "allow" },
        { "action": "shell", "resource": "pnpm exec prettier --check *", "effect": "allow" },
        { "action": "shell", "resource": "shellcheck *", "effect": "allow" },
        { "action": "shell", "resource": "biome *", "effect": "allow" },
        { "action": "shell", "resource": "bunx biome *", "effect": "allow" },
        { "action": "shell", "resource": "bunx run biome *", "effect": "allow" },
        { "action": "shell", "resource": "bunx @biomejs/biome *", "effect": "allow" },
        { "action": "shell", "resource": "npx biome *", "effect": "allow" },
        { "action": "shell", "resource": "npx @biomejs/biome *", "effect": "allow" },
        { "action": "shell", "resource": "pnpm exec biome *", "effect": "allow" },
        { "action": "shell", "resource": "eslint *", "effect": "allow" },
        { "action": "shell", "resource": "bunx eslint *", "effect": "allow" },
        { "action": "shell", "resource": "npx eslint *", "effect": "allow" },
        { "action": "shell", "resource": "pnpm exec eslint *", "effect": "allow" },
        { "action": "shell", "resource": "tsc *", "effect": "allow" },
        { "action": "shell", "resource": "bunx tsc *", "effect": "allow" },
        { "action": "shell", "resource": "npx tsc *", "effect": "allow" },
        { "action": "shell", "resource": "pnpm exec tsc *", "effect": "allow" },
        { "action": "shell", "resource": "vitest *", "effect": "allow" },
        { "action": "shell", "resource": "bunx vitest *", "effect": "allow" },
        { "action": "shell", "resource": "npx vitest *", "effect": "allow" },
        { "action": "shell", "resource": "pnpm exec vitest *", "effect": "allow" },
        { "action": "shell", "resource": "jest *", "effect": "allow" },
        { "action": "shell", "resource": "bunx jest *", "effect": "allow" },
        { "action": "shell", "resource": "npx jest *", "effect": "allow" },
        { "action": "shell", "resource": "pnpm exec jest *", "effect": "allow" },
        { "action": "shell", "resource": "bunx playwright test *", "effect": "allow" },
        { "action": "shell", "resource": "npx playwright test *", "effect": "allow" },
        { "action": "shell", "resource": "pnpm exec playwright test *", "effect": "allow" },
        { "action": "shell", "resource": "pytest *", "effect": "allow" },
        { "action": "shell", "resource": "python -m pytest *", "effect": "allow" },
        { "action": "shell", "resource": "python3 -m pytest *", "effect": "allow" },
        { "action": "shell", "resource": "python -m unittest *", "effect": "allow" },
        { "action": "shell", "resource": "python3 -m unittest *", "effect": "allow" },
        { "action": "shell", "resource": "uv run pytest *", "effect": "allow" },
        { "action": "shell", "resource": "ruff check *", "effect": "allow" },
        { "action": "shell", "resource": "uv run ruff check *", "effect": "allow" },
        { "action": "shell", "resource": "mypy *", "effect": "allow" },
        { "action": "shell", "resource": "uv run mypy *", "effect": "allow" },
        { "action": "shell", "resource": "cargo test *", "effect": "allow" },
        { "action": "shell", "resource": "cargo check *", "effect": "allow" },
        { "action": "shell", "resource": "cargo clippy *", "effect": "allow" },
        { "action": "shell", "resource": "cargo build *", "effect": "allow" },
        { "action": "shell", "resource": "go test *", "effect": "allow" },
        { "action": "shell", "resource": "go vet *", "effect": "allow" },
        { "action": "shell", "resource": "go build *", "effect": "allow" },
        { "action": "shell", "resource": "make test *", "effect": "allow" },
        { "action": "shell", "resource": "make check *", "effect": "allow" },
        { "action": "shell", "resource": "make lint *", "effect": "allow" },
        { "action": "webfetch", "resource": "*", "effect": "ask" },
        { "action": "aws-mcp_*", "resource": "*", "effect": "ask" }
      ]
    }
  },
  "permission": {
    "external_directory": {
      "~/Work": "allow",
      "~/Work/**": "allow",
      "~/.config/opencode": "allow",
      "~/.config/opencode/**": "allow",
      "~/.claude/skills": "allow",
      "~/.claude/skills/**": "allow",
      "~/.agents/skills": "allow",
      "~/.agents/skills/**": "allow"
    }
  }
}
